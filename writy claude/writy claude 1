import { useState, useRef, useEffect } from "react";

const MODEL = "claude-sonnet-4-20250514";
const SAVE_KEY = "book_generator_save_v2";
const GENRES = ["Fantasy", "Thriller", "Romance", "Sci-Fi", "Mystery", "Horror", "Literary Fiction", "Historical Fiction", "Adventure", "Crime", "Dystopian", "Custom..."];
const AUDIENCES = ["Middle Grade", "Young Adult (YA)", "Adult", "Literary / General"];
const STYLE_AUTHORS = ["No specific style", "Stephen King", "J.R.R. Tolkien", "Agatha Christie", "George R.R. Martin", "Jane Austen", "Ernest Hemingway", "Cormac McCarthy", "Gillian Flynn", "Brandon Sanderson", "Ursula K. Le Guin", "Custom..."];

function ShufflingDots({ message }) {
  const [positions, setPositions] = useState([0, 1, 2]);
  const [scales, setScales] = useState([1, 1, 1]);
  useEffect(() => {
    const interval = setInterval(() => {
      setPositions(prev => {
        const next = [...prev];
        const i = Math.floor(Math.random() * 3);
        const j = (i + 1 + Math.floor(Math.random() * 2)) % 3;
        [next[i], next[j]] = [next[j], next[i]];
        return next;
      });
      setScales([0.6 + Math.random() * 0.8, 0.6 + Math.random() * 0.8, 0.6 + Math.random() * 0.8]);
    }, 380);
    return () => clearInterval(interval);
  }, []);
  const colors = ["#c9a84c", "#a07838", "#e8c97a"];
  const sizes = [10, 13, 10];
  return (
    <div style={{ textAlign: "center" }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: "6px", marginBottom: "10px", height: "24px" }}>
        {positions.map((colorIdx, i) => (
          <span key={i} style={{ display: "inline-block", width: `${sizes[colorIdx]}px`, height: `${sizes[colorIdx]}px`, borderRadius: "50%", background: colors[colorIdx], transform: `scale(${scales[i]})`, transition: "transform 0.35s ease, width 0.35s ease, height 0.35s ease, background 0.35s ease" }} />
        ))}
      </div>
      <div style={{ color: "#c9a84c", fontSize: "17px" }}>{message}</div>
    </div>
  );
}

export default function BookGenerator() {
  const [stage, setStage] = useState("idea");
  const [bookIdea, setBookIdea] = useState("");
  const [seriesContext, setSeriesContext] = useState("");
  const [genre, setGenre] = useState("");
  const [customGenre, setCustomGenre] = useState("");
  const [audience, setAudience] = useState("");
  const [styleAuthor, setStyleAuthor] = useState("No specific style");
  const [customStyle, setCustomStyle] = useState("");
  const [outline, setOutline] = useState(null);
  const [chapters, setChapters] = useState([]);
  const [currentChapter, setCurrentChapter] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [loadingMsg, setLoadingMsg] = useState("");
  const [feedbackMode, setFeedbackMode] = useState(false);
  const [outlineFeedbackMode, setOutlineFeedbackMode] = useState(false);
  const [outlineFeedback, setOutlineFeedback] = useState("");
  const [feedback, setFeedback] = useState("");
  const [selectedChapter, setSelectedChapter] = useState(null);
  const [editingChapter, setEditingChapter] = useState(null);
  const [editContent, setEditContent] = useState("");
  const [copied, setCopied] = useState(false);
  const [copiedChapter, setCopiedChapter] = useState(null);
  const [saveStatus, setSaveStatus] = useState("idle");
  const [loadingBook, setLoadingBook] = useState(true);
  const [showSeriesBox, setShowSeriesBox] = useState(false);
  const [readMode, setReadMode] = useState(false);
  const [readFontSize, setReadFontSize] = useState(17);
  const chapterRef = useRef(null);

  useEffect(() => {
    (async () => {
      try {
        const result = await window.storage.get(SAVE_KEY);
        if (result?.value) {
          const s = JSON.parse(result.value);
          if (s.outline) setOutline(s.outline);
          if (s.chapters) setChapters(s.chapters);
          if (s.bookIdea) setBookIdea(s.bookIdea);
          if (s.seriesContext) { setSeriesContext(s.seriesContext); setShowSeriesBox(true); }
          if (s.currentChapter) setCurrentChapter(s.currentChapter);
          if (s.stage) setStage(s.stage);
          if (s.genre) setGenre(s.genre);
          if (s.customGenre) setCustomGenre(s.customGenre);
          if (s.audience) setAudience(s.audience);
          if (s.styleAuthor) setStyleAuthor(s.styleAuthor);
          if (s.customStyle) setCustomStyle(s.customStyle);
        }
      } catch (e) {}
      setLoadingBook(false);
    })();
  }, []);

  useEffect(() => {
    if (loadingBook) return;
    if (stage === "idea" && !outline) return;
    (async () => {
      setSaveStatus("saving");
      try {
        await window.storage.set(SAVE_KEY, JSON.stringify({ stage, bookIdea, seriesContext, genre, customGenre, audience, styleAuthor, customStyle, outline, chapters, currentChapter }));
        setSaveStatus("saved");
        setTimeout(() => setSaveStatus("idle"), 2000);
      } catch (e) { setSaveStatus("error"); }
    })();
  }, [stage, outline, chapters, currentChapter]);

  const wordCount = (text) => text?.trim().split(/\s+/).filter(Boolean).length || 0;
  const totalWords = chapters.reduce((sum, c) => sum + wordCount(c.content), 0);
  const currentWords = currentChapter ? wordCount(currentChapter.content) : 0;
  const effectiveGenre = genre === "Custom..." ? customGenre : genre;
  const effectiveStyle = styleAuthor === "Custom..." ? customStyle : styleAuthor === "No specific style" ? "" : styleAuthor;

  const callClaude = async (messages, system) => {
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ model: MODEL, max_tokens: 8000, system, messages })
    });
    if (!res.ok) throw new Error(`API error ${res.status}: ${await res.text()}`);
    const data = await res.json();
    if (data.error) throw new Error(data.error.message);
    return data.content?.[0]?.text || "";
  };

  const copyFullBook = () => {
    if (!outline || chapters.length === 0) return;
    const full = `${outline.title}\n\n` + chapters.map(c => `CHAPTER ${c.number}: ${c.title}\n\n${c.content}`).join("\n\n---\n\n");
    navigator.clipboard.writeText(full);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const copyChapter = (chap) => {
    navigator.clipboard.writeText(`Chapter ${chap.number}: ${chap.title}\n\n${chap.content}`);
    setCopiedChapter(chap.number);
    setTimeout(() => setCopiedChapter(null), 2000);
  };

  const resetBook = async () => {
    if (!confirm("Start a new book? Your current progress will be lost.")) return;
    try { await window.storage.delete(SAVE_KEY); } catch (e) {}
    setStage("idea"); setBookIdea(""); setSeriesContext(""); setOutline(null);
    setChapters([]); setCurrentChapter(null); setSelectedChapter(null); setShowSeriesBox(false);
    setGenre(""); setCustomGenre(""); setAudience(""); setStyleAuthor("No specific style"); setCustomStyle("");
    setEditingChapter(null);
  };

  const buildMetaNotes = () => {
    const parts = [];
    if (effectiveGenre) parts.push(`Genre/Tone: ${effectiveGenre}`);
    if (audience) parts.push(`Target Audience: ${audience}`);
    if (effectiveStyle) parts.push(`Writing Style: in the style of ${effectiveStyle}`);
    return parts.length ? "\n\n" + parts.join("\n") : "";
  };

  const generateOutline = async (feedbackText = null) => {
    if (!bookIdea.trim()) return;
    setIsLoading(true);
    setLoadingMsg("Crafting your story outline...");
    setOutlineFeedbackMode(false);
    const seriesNote = seriesContext.trim() ? `\n\nSeries context (previous books — background/consistency only):\n${seriesContext}` : "";
    const metaNotes = buildMetaNotes();
    const feedbackNote = feedbackText ? `\n\nUser feedback on previous outline: "${feedbackText}". Revise accordingly.` : "";
    const system = `You are a creative novelist. Given a book idea, generate a compelling novel outline.
Respond ONLY with valid JSON in this exact format, no markdown, no extra text:
{"title":"Book Title","chapters":[{"number":1,"title":"Chapter Title","summary":"2-3 sentence summary of what happens"}]}
Generate 15-20 chapters. Be creative but stay true to the idea. Each chapter should build naturally on the last.`;
    try {
      const text = await callClaude([{ role: "user", content: `Book idea: ${bookIdea}${metaNotes}${seriesNote}${feedbackNote}` }], system);
      const parsed = JSON.parse(text.replace(/```json|```/g, "").trim());
      setOutline(parsed);
      setStage("outline");
    } catch (e) { alert("Failed to generate outline: " + e.message); }
    setIsLoading(false);
  };

  const generateChapter = async (chapterInfo, prevChapters, userFeedback = null) => {
    setIsLoading(true);
    setLoadingMsg(`Writing Chapter ${chapterInfo.number}: "${chapterInfo.title}"...`);
    setFeedbackMode(false);
    let prevContext = "This is the first chapter.";
    if (prevChapters.length > 0) {
      const summaryOnly = prevChapters.slice(0, -2).map(c => `--- Chapter ${c.number}: ${c.title} (summary) ---\n${outline.chapters[c.number - 1]?.summary}`);
      const fullText = prevChapters.slice(-2).map(c => `--- Chapter ${c.number}: ${c.title} ---\n${c.content}`);
      prevContext = [...(summaryOnly.length ? [`Earlier chapters (summaries):\n${summaryOnly.join("\n")}`] : []), `Recent chapters (full text):\n${fullText.join("\n\n")}`].join("\n\n");
    }
    const metaNotes = buildMetaNotes();
    const feedbackNote = userFeedback ? `\n\nUser feedback on previous version: "${userFeedback}". Address this in your rewrite.` : "";
    const seriesNote = seriesContext.trim() ? `\n\nSeries context (previous books — background/consistency only):\n${seriesContext}` : "";
    const styleInstruction = effectiveStyle ? ` Write in the style of ${effectiveStyle}.` : "";
    const audienceInstruction = audience ? ` The target audience is ${audience}.` : "";
    const genreInstruction = effectiveGenre ? ` The genre/tone is ${effectiveGenre}.` : "";
    const system = `You are a skilled novelist.${genreInstruction}${audienceInstruction}${styleInstruction} Write immersive prose with rich descriptions, strong dialogue, and compelling character development. Each chapter must be AT LEAST 6000 words. Do not summarize — write the full scene. Stay consistent with established characters, plot, and tone.`;
    const prompt = `Book title: "${outline.title}"\nOriginal idea: ${bookIdea}${metaNotes}${seriesNote}\n\nFull outline:\n${outline.chapters.map(c => `Chapter ${c.number} - ${c.title}: ${c.summary}`).join("\n")}\n\n${prevContext}\n\nNow write Chapter ${chapterInfo.number}: "${chapterInfo.title}"\nSummary: ${chapterInfo.summary}${feedbackNote}\n\nWrite the full chapter now, at least 6000 words. Start directly with the content.`;
    try {
      const content = await callClaude([{ role: "user", content: prompt }], system);
      if (!content || content.trim().length < 500) throw new Error("Response too short. Try refreshing and continuing.");
      setIsLoading(false);
      return { number: chapterInfo.number, title: chapterInfo.title, content };
    } catch (e) {
      setIsLoading(false);
      alert("Failed to generate chapter: " + e.message);
      return null;
    }
  };

  const startWriting = async () => {
    setStage("writing");
    const chap = await generateChapter(outline.chapters[0], []);
    if (chap) { setCurrentChapter(chap); chapterRef.current?.scrollTo(0, 0); }
  };

  const approveChapter = async () => {
    const updated = [...chapters, currentChapter];
    setChapters(updated);
    const nextIndex = updated.length;
    if (nextIndex >= outline.chapters.length) { setStage("done"); setCurrentChapter(null); return; }
    const chap = await generateChapter(outline.chapters[nextIndex], updated);
    if (chap) { setCurrentChapter(chap); chapterRef.current?.scrollTo(0, 0); }
  };

  const submitFeedback = async () => {
    const chap = await generateChapter(outline.chapters[currentChapter.number - 1], chapters, feedback);
    if (chap) { setCurrentChapter(chap); setFeedback(""); chapterRef.current?.scrollTo(0, 0); }
  };

  const saveChapterEdit = () => {
    if (editingChapter === "current") {
      setCurrentChapter(prev => ({ ...prev, content: editContent }));
    } else {
      setChapters(prev => prev.map(c => c.number === editingChapter ? { ...c, content: editContent } : c));
      if (selectedChapter?.number === editingChapter) setSelectedChapter(prev => ({ ...prev, content: editContent }));
    }
    setEditingChapter(null);
  };

  const startEdit = (chap, isCurrentChap = false) => {
    setEditContent(chap.content);
    setEditingChapter(isCurrentChap ? "current" : chap.number);
  };

  const progressPct = outline ? Math.round((chapters.length / outline.chapters.length) * 100) : 0;
  const displayChapter = selectedChapter || currentChapter;

  if (loadingBook) return (
    <div style={{ fontFamily: "Georgia, serif", minHeight: "100vh", background: "#0f0f1a", color: "#c9a84c", display: "flex", alignItems: "center", justifyContent: "center", flexDirection: "column", gap: "16px" }}>
      <div style={{ fontSize: "48px" }}>📖</div>
      <div style={{ fontSize: "18px" }}>Loading your book...</div>
    </div>
  );

  // Read Mode Overlay
  if (readMode && displayChapter) return (
    <div style={{ fontFamily: "Georgia, serif", minHeight: "100vh", background: "#0f0f1a", color: "#e8e0d0", display: "flex", flexDirection: "column" }}>
      <div style={{ background: "#1a1a2e", borderBottom: "1px solid #333", padding: "10px 24px", display: "flex", alignItems: "center", gap: "12px" }}>
        <button onClick={() => setReadMode(false)} style={{ background: "transparent", color: "#c9a84c", border: "1px solid #c9a84c", borderRadius: "6px", padding: "5px 14px", fontSize: "13px", cursor: "pointer", fontFamily: "Georgia, serif" }}>✕ Exit Read Mode</button>
        <span style={{ color: "#c9a84c", fontWeight: "bold", fontSize: "15px", marginLeft: "8px" }}>{displayChapter.title}</span>
        <div style={{ marginLeft: "auto", display: "flex", alignItems: "center", gap: "10px" }}>
          <span style={{ color: "#666", fontSize: "13px" }}>Font size:</span>
          <button onClick={() => setReadFontSize(s => Math.max(13, s - 1))} style={{ background: "#2a2a3e", color: "#c9a84c", border: "none", borderRadius: "5px", width: "28px", height: "28px", cursor: "pointer", fontSize: "16px" }}>−</button>
          <span style={{ color: "#aaa", fontSize: "13px", minWidth: "28px", textAlign: "center" }}>{readFontSize}</span>
          <button onClick={() => setReadFontSize(s => Math.min(28, s + 1))} style={{ background: "#2a2a3e", color: "#c9a84c", border: "none", borderRadius: "5px", width: "28px", height: "28px", cursor: "pointer", fontSize: "16px" }}>+</button>
        </div>
      </div>
      <div style={{ flex: 1, overflowY: "auto", display: "flex", justifyContent: "center", padding: "48px 24px" }}>
        <div style={{ maxWidth: "680px", width: "100%" }}>
          <div style={{ color: "#666", fontSize: "13px", marginBottom: "8px" }}>Chapter {displayChapter.number} of {outline?.chapters.length} · {wordCount(displayChapter.content).toLocaleString()} words</div>
          <h2 style={{ color: "#c9a84c", fontSize: "30px", marginBottom: "36px", lineHeight: 1.3 }}>{displayChapter.title}</h2>
          <div style={{ lineHeight: "2", fontSize: `${readFontSize}px`, color: "#e8e0d0", whiteSpace: "pre-wrap" }}>{displayChapter.content}</div>
        </div>
      </div>
    </div>
  );

  return (
    <div style={{ fontFamily: "Georgia, serif", minHeight: "100vh", background: "#0f0f1a", color: "#e8e0d0", display: "flex", flexDirection: "column" }}>
      {/* Header */}
      <div style={{ background: "#1a1a2e", borderBottom: "1px solid #333", padding: "12px 24px", display: "flex", alignItems: "center", gap: "12px", flexWrap: "wrap" }}>
        <span style={{ fontSize: "22px" }}>📖</span>
        <span style={{ fontSize: "18px", fontWeight: "bold", color: "#c9a84c" }}>AI Book Generator</span>
        {outline && <span style={{ color: "#aaa", fontSize: "13px" }}>— {outline.title}</span>}
        <div style={{ marginLeft: "auto", display: "flex", gap: "8px", alignItems: "center", flexWrap: "wrap" }}>
          <span style={{ fontSize: "11px", color: saveStatus === "saved" ? "#6dbf6d" : saveStatus === "saving" ? "#c9a84c" : saveStatus === "error" ? "#bf6d6d" : "#555" }}>
            {saveStatus === "saving" ? "💾 Saving..." : saveStatus === "saved" ? "✓ Saved" : saveStatus === "error" ? "⚠ Save failed" : ""}
          </span>
          {(stage === "writing" || stage === "done") && <>
            <span style={{ background: "#1e1e3a", border: "1px solid #3a3a5e", borderRadius: "6px", padding: "4px 10px", fontSize: "12px", color: "#a0a0ff" }}>📝 {totalWords.toLocaleString()} words</span>
            {currentChapter && stage === "writing" && <span style={{ background: "#1e1e3a", border: "1px solid #3a3a5e", borderRadius: "6px", padding: "4px 10px", fontSize: "12px", color: "#c9a84c" }}>✍️ Ch.{currentChapter.number}: {currentWords.toLocaleString()} words</span>}
          </>}
          {displayChapter && stage === "writing" && <button onClick={() => setReadMode(true)} style={{ padding: "5px 12px", background: "#1e1e3a", color: "#a0a0ff", border: "1px solid #3a3a5e", borderRadius: "6px", fontSize: "12px", cursor: "pointer", fontFamily: "Georgia, serif" }}>📖 Read Mode</button>}
          {chapters.length > 0 && <button onClick={copyFullBook} style={{ padding: "5px 12px", background: copied ? "#2d5a2d" : "#c9a84c", color: copied ? "#6dbf6d" : "#0f0f1a", border: "none", borderRadius: "6px", fontSize: "12px", fontWeight: "bold", cursor: "pointer", fontFamily: "Georgia, serif" }}>{copied ? "✓ Copied!" : "📋 Copy Book"}</button>}
          {stage !== "idea" && <button onClick={resetBook} style={{ padding: "5px 12px", background: "transparent", color: "#bf6d6d", border: "1px solid #bf6d6d", borderRadius: "6px", fontSize: "12px", cursor: "pointer", fontFamily: "Georgia, serif" }}>🗑 New Book</button>}
        </div>
      </div>

      {/* Progress bar */}
      {outline && stage !== "idea" && stage !== "outline" && (
        <div style={{ background: "#13131f", borderBottom: "1px solid #2a2a3e", padding: "8px 24px", display: "flex", alignItems: "center", gap: "12px" }}>
          <span style={{ fontSize: "12px", color: "#888", whiteSpace: "nowrap" }}>{chapters.length} / {outline.chapters.length} chapters</span>
          <div style={{ flex: 1, background: "#2a2a3e", borderRadius: "99px", height: "8px", overflow: "hidden" }}>
            <div style={{ width: `${progressPct}%`, background: "linear-gradient(90deg, #c9a84c, #e8c97a)", height: "100%", borderRadius: "99px", transition: "width 0.5s ease" }} />
          </div>
          <span style={{ fontSize: "12px", color: "#c9a84c", whiteSpace: "nowrap" }}>{progressPct}% complete</span>
        </div>
      )}

      <div style={{ display: "flex", flex: 1, overflow: "hidden" }}>
        {/* Sidebar */}
        {stage !== "idea" && (
          <div style={{ width: "220px", background: "#13131f", borderRight: "1px solid #2a2a3e", overflowY: "auto", padding: "14px", flexShrink: 0 }}>
            <div style={{ fontSize: "11px", textTransform: "uppercase", letterSpacing: "1px", color: "#666", marginBottom: "10px" }}>Chapters</div>
            {outline?.chapters.map(c => {
              const done = chapters.find(ch => ch.number === c.number);
              const isCurrent = currentChapter?.number === c.number && !selectedChapter;
              return (
                <div key={c.number} onClick={() => done ? setSelectedChapter(done) : isCurrent ? setSelectedChapter(null) : null}
                  style={{ padding: "7px 10px", borderRadius: "6px", marginBottom: "3px", fontSize: "12px", cursor: done ? "pointer" : "default", background: isCurrent ? "#2a2a4e" : selectedChapter?.number === c.number ? "#1e2a1e" : done ? "#1a2a1a" : "transparent", color: isCurrent ? "#a0a0ff" : done ? "#6dbf6d" : "#555", border: isCurrent ? "1px solid #4444aa" : "1px solid transparent" }}>
                  <div>{done ? "✓" : isCurrent ? "✍️" : "○"} Ch.{c.number}: {c.title}</div>
                  {done && <div style={{ fontSize: "10px", color: "#555", marginTop: "2px" }}>{wordCount(done.content).toLocaleString()} words</div>}
                </div>
              );
            })}
          </div>
        )}

        {/* Main */}
        <div style={{ flex: 1, overflowY: "auto", padding: "32px", display: "flex", flexDirection: "column", alignItems: "center" }} ref={chapterRef}>

          {/* Idea input */}
          {stage === "idea" && (
            <div style={{ maxWidth: "660px", width: "100%", marginTop: "40px" }}>
              <h1 style={{ color: "#c9a84c", marginBottom: "8px", fontSize: "28px" }}>Tell me your book idea</h1>
              <p style={{ color: "#888", marginBottom: "20px", fontSize: "15px" }}>Describe your story — characters, plot, setting, themes. The more detail, the better.</p>
              <textarea value={bookIdea} onChange={e => setBookIdea(e.target.value)}
                placeholder="e.g. A young archaeologist discovers an ancient map that leads to a hidden civilization beneath the Sahara..."
                style={{ width: "100%", minHeight: "140px", background: "#1a1a2e", border: "1px solid #333", borderRadius: "10px", padding: "16px", color: "#e8e0d0", fontSize: "15px", fontFamily: "Georgia, serif", resize: "vertical", boxSizing: "border-box" }} />

              {/* Genre */}
              <div style={{ marginTop: "22px" }}>
                <div style={{ fontSize: "13px", color: "#a0a0ff", marginBottom: "10px" }}>Genre / Tone</div>
                <div style={{ display: "flex", flexWrap: "wrap", gap: "8px" }}>
                  {GENRES.map(g => (
                    <button key={g} onClick={() => setGenre(g === genre ? "" : g)}
                      style={{ padding: "6px 14px", borderRadius: "20px", fontSize: "13px", cursor: "pointer", fontFamily: "Georgia, serif", background: genre === g ? "#c9a84c" : "#1a1a2e", color: genre === g ? "#0f0f1a" : "#aaa", border: genre === g ? "1px solid #c9a84c" : "1px solid #333", transition: "all 0.15s" }}>
                      {g}
                    </button>
                  ))}
                </div>
                {genre === "Custom..." && (
                  <input value={customGenre} onChange={e => setCustomGenre(e.target.value)} placeholder="e.g. Gothic horror romance..."
                    style={{ marginTop: "10px", width: "100%", background: "#1a1a2e", border: "1px solid #555", borderRadius: "8px", padding: "10px 14px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", boxSizing: "border-box" }} />
                )}
              </div>

              {/* Audience */}
              <div style={{ marginTop: "22px" }}>
                <div style={{ fontSize: "13px", color: "#a0a0ff", marginBottom: "10px" }}>Target Audience</div>
                <div style={{ display: "flex", flexWrap: "wrap", gap: "8px" }}>
                  {AUDIENCES.map(a => (
                    <button key={a} onClick={() => setAudience(a === audience ? "" : a)}
                      style={{ padding: "6px 14px", borderRadius: "20px", fontSize: "13px", cursor: "pointer", fontFamily: "Georgia, serif", background: audience === a ? "#c9a84c" : "#1a1a2e", color: audience === a ? "#0f0f1a" : "#aaa", border: audience === a ? "1px solid #c9a84c" : "1px solid #333", transition: "all 0.15s" }}>
                      {a}
                    </button>
                  ))}
                </div>
              </div>

              {/* Writing Style */}
              <div style={{ marginTop: "22px" }}>
                <div style={{ fontSize: "13px", color: "#a0a0ff", marginBottom: "10px" }}>Writing Style Inspiration</div>
                <select value={styleAuthor} onChange={e => setStyleAuthor(e.target.value)}
                  style={{ background: "#1a1a2e", border: "1px solid #333", borderRadius: "8px", padding: "9px 14px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", width: "100%", boxSizing: "border-box" }}>
                  {STYLE_AUTHORS.map(a => <option key={a} value={a}>{a}</option>)}
                </select>
                {styleAuthor === "Custom..." && (
                  <input value={customStyle} onChange={e => setCustomStyle(e.target.value)} placeholder="e.g. Kazuo Ishiguro, Raymond Carver..."
                    style={{ marginTop: "10px", width: "100%", background: "#1a1a2e", border: "1px solid #555", borderRadius: "8px", padding: "10px 14px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", boxSizing: "border-box" }} />
                )}
              </div>

              {/* Series context */}
              <div style={{ marginTop: "18px" }}>
                <button onClick={() => setShowSeriesBox(v => !v)}
                  style={{ background: "transparent", border: "1px dashed #555", borderRadius: "7px", color: "#888", padding: "7px 14px", fontSize: "13px", cursor: "pointer", fontFamily: "Georgia, serif" }}>
                  {showSeriesBox ? "✕ Remove series context" : "+ Add previous book(s) in series (optional)"}
                </button>
              </div>
              {showSeriesBox && (
                <div style={{ marginTop: "14px" }}>
                  <label style={{ fontSize: "13px", color: "#a0a0ff", display: "block", marginBottom: "6px" }}>📚 Previous book(s) — <span style={{ color: "#666" }}>used for context only</span></label>
                  <textarea value={seriesContext} onChange={e => setSeriesContext(e.target.value)}
                    placeholder="e.g. Book 1 - 'The First Map': Elena Voss discovers an ancient order..."
                    style={{ width: "100%", minHeight: "110px", background: "#1a1a2e", border: "1px solid #3a3a5e", borderRadius: "10px", padding: "14px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", resize: "vertical", boxSizing: "border-box" }} />
                </div>
              )}

              {!isLoading && (
                <button onClick={() => generateOutline()} disabled={!bookIdea.trim()}
                  style={{ marginTop: "24px", padding: "12px 32px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "16px", fontWeight: "bold", cursor: "pointer", opacity: !bookIdea.trim() ? 0.5 : 1 }}>
                  Generate Outline →
                </button>
              )}
              {isLoading && <div style={{ textAlign: "center", marginTop: "40px" }}><ShufflingDots message={loadingMsg} /></div>}
            </div>
          )}

          {/* Outline */}
          {stage === "outline" && outline && !isLoading && (
            <div style={{ maxWidth: "680px", width: "100%" }}>
              <h2 style={{ color: "#c9a84c", fontSize: "26px", marginBottom: "4px" }}>{outline.title}</h2>
              <div style={{ display: "flex", gap: "10px", alignItems: "center", marginBottom: "24px", flexWrap: "wrap" }}>
                <span style={{ color: "#888" }}>{outline.chapters.length} chapters planned</span>
                {effectiveGenre && <span style={{ background: "#1e1e3a", border: "1px solid #3a3a5e", borderRadius: "99px", padding: "2px 10px", fontSize: "12px", color: "#a0a0ff" }}>{effectiveGenre}</span>}
                {audience && <span style={{ background: "#1e1e3a", border: "1px solid #3a3a5e", borderRadius: "99px", padding: "2px 10px", fontSize: "12px", color: "#a0a0ff" }}>{audience}</span>}
                {effectiveStyle && <span style={{ background: "#1e1e3a", border: "1px solid #3a3a5e", borderRadius: "99px", padding: "2px 10px", fontSize: "12px", color: "#a0a0ff" }}>Style: {effectiveStyle}</span>}
              </div>
              {outline.chapters.map(c => (
                <div key={c.number} style={{ background: "#1a1a2e", border: "1px solid #2a2a3e", borderRadius: "8px", padding: "14px 18px", marginBottom: "10px" }}>
                  <div style={{ color: "#a0a0ff", fontWeight: "bold", marginBottom: "4px" }}>Chapter {c.number}: {c.title}</div>
                  <div style={{ color: "#aaa", fontSize: "14px" }}>{c.summary}</div>
                </div>
              ))}
              {!outlineFeedbackMode ? (
                <div style={{ display: "flex", gap: "12px", marginTop: "20px", flexWrap: "wrap" }}>
                  <button onClick={startWriting} style={{ padding: "12px 32px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "16px", fontWeight: "bold", cursor: "pointer" }}>Start Writing the Novel →</button>
                  <button onClick={() => setOutlineFeedbackMode(true)} style={{ padding: "12px 24px", background: "transparent", color: "#c9a84c", border: "1px solid #c9a84c", borderRadius: "8px", fontSize: "15px", cursor: "pointer", fontFamily: "Georgia, serif" }}>🔄 Regenerate Outline</button>
                </div>
              ) : (
                <div style={{ marginTop: "20px", background: "#1a1a2e", border: "1px solid #3a3a5e", borderRadius: "10px", padding: "20px" }}>
                  <p style={{ color: "#c9a84c", marginBottom: "12px", fontSize: "15px" }}>What would you like changed in the outline?</p>
                  <textarea value={outlineFeedback} onChange={e => setOutlineFeedback(e.target.value)}
                    placeholder="e.g. Make it darker, add a plot twist in the middle, fewer chapters..."
                    style={{ width: "100%", minHeight: "90px", background: "#13131f", border: "1px solid #444", borderRadius: "8px", padding: "12px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", boxSizing: "border-box", resize: "vertical" }} />
                  <div style={{ display: "flex", gap: "10px", marginTop: "12px" }}>
                    <button onClick={() => generateOutline(outlineFeedback)} disabled={!outlineFeedback.trim()}
                      style={{ padding: "10px 24px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "15px", fontWeight: "bold", cursor: "pointer", opacity: !outlineFeedback.trim() ? 0.5 : 1 }}>
                      Regenerate
                    </button>
                    <button onClick={() => setOutlineFeedbackMode(false)} style={{ padding: "10px 18px", background: "transparent", color: "#888", border: "1px solid #555", borderRadius: "8px", fontSize: "15px", cursor: "pointer" }}>Cancel</button>
                  </div>
                </div>
              )}
            </div>
          )}

          {/* Loading */}
          {isLoading && (stage === "outline" || stage === "writing") && (
            <div style={{ textAlign: "center", marginTop: "60px", display: "flex", flexDirection: "column", alignItems: "center", gap: "28px" }}>
              <ShufflingDots message={loadingMsg} />
              <div style={{ color: "#555", fontSize: "13px" }}>This may take a moment…</div>
            </div>
          )}

          {/* Chapter display */}
          {!isLoading && stage === "writing" && displayChapter && !editingChapter && (
            <div style={{ maxWidth: "740px", width: "100%" }}>
              {selectedChapter && (
                <button onClick={() => setSelectedChapter(null)} style={{ background: "transparent", color: "#c9a84c", border: "none", cursor: "pointer", fontSize: "14px", marginBottom: "16px", padding: 0 }}>← Back to current chapter</button>
              )}
              <div style={{ display: "flex", alignItems: "center", gap: "10px", marginBottom: "4px", flexWrap: "wrap" }}>
                <div style={{ color: "#888", fontSize: "13px" }}>Chapter {displayChapter.number} of {outline.chapters.length}</div>
                <div style={{ color: "#555", fontSize: "12px" }}>{wordCount(displayChapter.content).toLocaleString()} words</div>
                <div style={{ marginLeft: "auto", display: "flex", gap: "8px" }}>
                  <button onClick={() => startEdit(displayChapter, !selectedChapter && displayChapter === currentChapter)}
                    style={{ padding: "4px 12px", background: "transparent", color: "#a0a0ff", border: "1px solid #4444aa", borderRadius: "5px", fontSize: "12px", cursor: "pointer", fontFamily: "Georgia, serif" }}>✏️ Edit</button>
                  <button onClick={() => setReadMode(true)}
                    style={{ padding: "4px 12px", background: "transparent", color: "#888", border: "1px solid #444", borderRadius: "5px", fontSize: "12px", cursor: "pointer", fontFamily: "Georgia, serif" }}>📖 Read</button>
                  <button onClick={() => copyChapter(displayChapter)}
                    style={{ padding: "4px 12px", background: copiedChapter === displayChapter.number ? "#2d5a2d" : "transparent", color: copiedChapter === displayChapter.number ? "#6dbf6d" : "#888", border: `1px solid ${copiedChapter === displayChapter.number ? "#6dbf6d" : "#444"}`, borderRadius: "5px", fontSize: "12px", cursor: "pointer", fontFamily: "Georgia, serif" }}>
                    {copiedChapter === displayChapter.number ? "✓ Copied!" : "📋 Copy"}
                  </button>
                </div>
              </div>
              <h2 style={{ color: "#c9a84c", fontSize: "26px", marginBottom: "24px" }}>{displayChapter.title}</h2>
              <div style={{ lineHeight: "1.9", fontSize: "16px", color: "#ddd", whiteSpace: "pre-wrap", marginBottom: "40px" }}>{displayChapter.content}</div>

              {!selectedChapter && (
                !feedbackMode ? (
                  <div style={{ display: "flex", gap: "16px", justifyContent: "center", padding: "24px 0", borderTop: "1px solid #2a2a3e" }}>
                    <button onClick={approveChapter} style={{ padding: "12px 36px", background: "#2d5a2d", color: "#6dbf6d", border: "1px solid #6dbf6d", borderRadius: "8px", fontSize: "16px", cursor: "pointer", fontFamily: "Georgia, serif" }}>👍 Looks great! Next chapter</button>
                    <button onClick={() => setFeedbackMode(true)} style={{ padding: "12px 36px", background: "#5a2d2d", color: "#bf6d6d", border: "1px solid #bf6d6d", borderRadius: "8px", fontSize: "16px", cursor: "pointer", fontFamily: "Georgia, serif" }}>👎 Rewrite this chapter</button>
                  </div>
                ) : (
                  <div style={{ borderTop: "1px solid #2a2a3e", paddingTop: "24px" }}>
                    <p style={{ color: "#c9a84c", marginBottom: "12px" }}>What should be improved or changed?</p>
                    <textarea value={feedback} onChange={e => setFeedback(e.target.value)} placeholder="e.g. The pacing felt too slow, add more tension..."
                      style={{ width: "100%", minHeight: "100px", background: "#1a1a2e", border: "1px solid #555", borderRadius: "8px", padding: "12px", color: "#e8e0d0", fontSize: "14px", fontFamily: "Georgia, serif", boxSizing: "border-box", resize: "vertical" }} />
                    <div style={{ display: "flex", gap: "12px", marginTop: "12px" }}>
                      <button onClick={submitFeedback} disabled={!feedback.trim()} style={{ padding: "10px 28px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "15px", fontWeight: "bold", cursor: "pointer", opacity: !feedback.trim() ? 0.5 : 1 }}>Rewrite with Feedback</button>
                      <button onClick={() => setFeedbackMode(false)} style={{ padding: "10px 20px", background: "transparent", color: "#888", border: "1px solid #555", borderRadius: "8px", fontSize: "15px", cursor: "pointer" }}>Cancel</button>
                    </div>
                  </div>
                )
              )}
            </div>
          )}

          {/* Edit Mode */}
          {!isLoading && editingChapter !== null && (
            <div style={{ maxWidth: "740px", width: "100%" }}>
              <div style={{ display: "flex", alignItems: "center", gap: "12px", marginBottom: "20px" }}>
                <h2 style={{ color: "#c9a84c", fontSize: "22px", margin: 0 }}>✏️ Editing Chapter</h2>
                <span style={{ color: "#555", fontSize: "13px" }}>{wordCount(editContent).toLocaleString()} words</span>
              </div>
              <textarea value={editContent} onChange={e => setEditContent(e.target.value)}
                style={{ width: "100%", minHeight: "60vh", background: "#1a1a2e", border: "1px solid #555", borderRadius: "10px", padding: "20px", color: "#e8e0d0", fontSize: "15px", fontFamily: "Georgia, serif", lineHeight: "1.8", boxSizing: "border-box", resize: "vertical" }} />
              <div style={{ display: "flex", gap: "12px", marginTop: "16px" }}>
                <button onClick={saveChapterEdit} style={{ padding: "10px 28px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "15px", fontWeight: "bold", cursor: "pointer" }}>💾 Save Edits</button>
                <button onClick={() => setEditingChapter(null)} style={{ padding: "10px 20px", background: "transparent", color: "#888", border: "1px solid #555", borderRadius: "8px", fontSize: "15px", cursor: "pointer" }}>Cancel</button>
              </div>
            </div>
          )}

          {/* Done */}
          {stage === "done" && (
            <div style={{ textAlign: "center", marginTop: "80px", maxWidth: "560px" }}>
              <div style={{ fontSize: "64px", marginBottom: "16px" }}>🎉</div>
              <h2 style={{ color: "#c9a84c", fontSize: "28px" }}>Your novel is complete!</h2>
              <p style={{ color: "#aaa", marginTop: "12px", lineHeight: "1.7" }}>"{outline?.title}" — {chapters.length} chapters, {totalWords.toLocaleString()} total words.</p>
              <div style={{ display: "flex", gap: "12px", justifyContent: "center", marginTop: "24px", flexWrap: "wrap" }}>
                <button onClick={copyFullBook} style={{ padding: "12px 28px", background: "#c9a84c", color: "#0f0f1a", border: "none", borderRadius: "8px", fontSize: "15px", fontWeight: "bold", cursor: "pointer" }}>
                  {copied ? "✓ Copied!" : "📋 Copy Full Book"}
                </button>
              </div>
              <p style={{ color: "#666", fontSize: "13px", marginTop: "16px" }}>You can also copy individual chapters from the sidebar.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}